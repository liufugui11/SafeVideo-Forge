# 应用配置
DEBUG=true
HOST=127.0.0.1
PORT=8000

# ===== AI模型API配置 =====
# 至少配置一个模型API Key才能正常使用

# DeepSeek (推荐 - 性价比高)
DEEPSEEK_API_KEY=

# Kimi / Moonshot (推荐 - 长文本)
KIMI_API_KEY=

# 通义千问/万相 (推荐 - 图像视频生成)
DASHSCOPE_API_KEY=

# 豆包
DOUBAO_API_KEY=

# OpenAI (可选)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# ===== 视频处理配置 =====
FFMPEG_PATH=ffmpeg
MAX_VIDEO_DURATION=180
DEFAULT_VIDEO_FPS=30

# ===== 音频配置 =====
DEFAULT_TTS_VOICE=zh-CN-XiaoxiaoNeural
DEFAULT_BGM_VOLUME=0.15
