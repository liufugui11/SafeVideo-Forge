{
  "name": "safevideo-forge",
  "version": "0.1.0",
  "description": "安全生产视频智能生产工具",
  "main": "dist-electron/main.js",
  "author": "SafeVideo Forge Team",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "build:electron": "vue-tsc --noEmit && vite build && electron-builder",
    "build:win": "npm run build:electron -- --win",
    "build:mac": "npm run build:electron -- --mac",
    "build:linux": "npm run build:electron -- --linux",
    "preview": "vite preview",
    "lint": "eslint . --ext .vue,.ts,.tsx --fix",
    "typecheck": "vue-tsc --noEmit"
  },
  "dependencies": {
    "vue": "^3.4.0",
    "vue-router": "^4.2.0",
    "pinia": "^2.1.0",
    "axios": "^1.6.0",
    "element-plus": "^2.5.0",
    "@element-plus/icons-vue": "^2.3.0",
    "dayjs": "^1.11.0",
    "lodash-es": "^4.17.0",
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.0",
    "vite": "^5.0.0",
    "vite-plugin-electron": "^0.28.0",
    "vite-plugin-electron-renderer": "^0.14.0",
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0",
    "vue-tsc": "^1.8.0",
    "typescript": "^5.3.0",
    "@types/node": "^20.0.0",
    "@types/lodash-es": "^4.17.0",
    "@types/js-yaml": "^4.0.0",
    "eslint": "^8.56.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint-plugin-vue": "^9.0.0",
    "sass": "^1.70.0"
  }
}
